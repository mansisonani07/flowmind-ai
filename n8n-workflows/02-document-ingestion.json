{
  "name": "Document Ingestion",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ingest",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "b1b2c3d4-1111-4aaa-b111-000000000001",
      "name": "Ingest Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "document-ingest-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FASTAPI_URL }}/upload",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ file_url: $json.file_url || null, file_base64: $json.file_base64 || null, filename: $json.filename || 'document.pdf' }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "b1b2c3d4-2222-4bbb-c222-000000000002",
      "name": "Upload to FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_ADMIN_CHAT_ID, text: '📄 New Document Ingested\n\nFilename: ' + ($json.filename || 'Unknown') + '\nStatus: ' + ($json.status || 'Processing') + '\nChunks: ' + ($json.chunks_created || 'N/A') + '\nTimestamp: ' + new Date().toISOString(), parse_mode: 'HTML' }) }}",
        "options": {}
      },
      "id": "b1b2c3d4-3333-4ccc-d333-000000000003",
      "name": "Notify Admin Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEETS_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "DocumentUploads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ new Date().toISOString() }}",
            "Filename": "={{ $('Ingest Webhook').item.json.filename || 'Unknown' }}",
            "File URL": "={{ $('Ingest Webhook').item.json.file_url || 'Base64 upload' }}",
            "Status": "={{ $json.status || 'Unknown' }}",
            "Chunks Created": "={{ $json.chunks_created || 0 }}",
            "Error": "={{ $json.error || '' }}"
          }
        },
        "options": {}
      },
      "id": "b1b2c3d4-4444-4ddd-e444-000000000004",
      "name": "Log Upload Event",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        940,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "google-sheets-credentials",
          "name": "Google Sheets API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'ok', message: 'Document ingestion started', filename: $('Ingest Webhook').item.json.filename }) }}",
        "options": {}
      },
      "id": "b1b2c3d4-5555-4eee-f555-000000000005",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        300
      ]
    }
  ],
  "connections": {
    "Ingest Webhook": {
      "main": [
        [
          {
            "node": "Upload to FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to FastAPI": {
      "main": [
        [
          {
            "node": "Notify Admin Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Admin Telegram": {
      "main": [
        [
          {
            "node": "Log Upload Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Upload Event": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "instanceId": "flowmind-prod"
  }
}