APP_NAME=FlowMind AI
APP_VERSION=3.0.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me

# Frontend
VITE_DEMO_MODE=true
VITE_API_URL=http://localhost:8000

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Groq AI
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Worker
CF_WORKER_ROUTE=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
